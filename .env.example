# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Náhodný reťazec (napr. `openssl rand -hex 32`) – šifruje Google token v databáze
ENCRYPTION_KEY=
# Náhodný reťazec – chráni cron endpointy (Vercel ho posiela automaticky)
CRON_SECRET=

# Adresa aplikácie (lokálne http://localhost:3000, po nasadení https://…vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
